require spatial

statement ok
CREATE TABLE blobs (id INTEGER, b BLOB);

statement ok
INSERT INTO blobs VALUES
    (1, unhex('0101000000000000000000f03f0000000000000040')),
    (2, NULL),
    (3, unhex('010200000002000000000000000000f03f000000000000f03f00000000000000400000000000000040')),
    (4, NULL),
    (5, unhex('01030000000100000004000000000000000000000000000000000000000000000000000040000000000000000000000000000000400000000000000040000000000000000000000000000000000000000000000000'));

query I
SELECT ST_Point2DFromWKB(b)::VARCHAR FROM blobs WHERE id IN (1, 2) ORDER BY id;
----
POINT (1 2)
NULL

query I
SELECT ST_LineString2DFromWKB(b)::VARCHAR FROM blobs WHERE id IN (3, 4) ORDER BY id;
----
LINESTRING (1 1, 2 2)
NULL

query I
SELECT ST_Polygon2DFromWKB(b)::VARCHAR FROM blobs WHERE id IN (4, 5) ORDER BY id;
----
NULL
POLYGON ((0 0, 2 0, 2 2, 0 0))

query I
SELECT ST_Point2DFromWKB(NULL::BLOB)::VARCHAR;
----
NULL
