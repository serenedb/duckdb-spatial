# name: test/sql/geometry/st_affine.test
# group: [geometry]

require spatial

# Move a point by (2, 3) 
query I
SELECT ST_Affine(ST_Point(1, 1), 1, 0, 0, 0, 1, 0, 0, 0, 1, 2, 3, 0);
----
POINT (3 4)

query I
SELECT ST_Affine(ST_Point(1, 1), 1, 0, 5, 0, 1, 5, 0, 0, 1, 0, 0, 0);
----
POINT (1 1)

query I
SELECT ST_Translate(ST_Point(1, 1), 2, 3);
----
POINT (3 4)

query I
SELECT ST_Translate(ST_GeomFromText('POINT Z(1 2 3)'), 1, 1, 1);
----
POINT Z (2 3 4)

query I
SELECT ST_Translate(ST_GeomFromText('POINT Z(1 2 3)'), 2, 3);
----
POINT Z (3 5 3)

query I
SELECT ST_Scale(ST_GeomFromText('POINT Z(1 2 3)'), 2, 2, 2);
----
POINT Z (2 4 6)

query II
SELECT round(ST_X(g), 9), round(ST_Y(g), 9) FROM (SELECT ST_RotateX(ST_Point(0, 1), pi() / 2) AS g);
----
0.0	0.0

query II
SELECT round(ST_X(g), 9), round(ST_Y(g), 9) FROM (SELECT ST_RotateY(ST_Point(1, 0), pi() / 2) AS g);
----
0.0	0.0
