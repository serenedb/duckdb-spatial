require spatial

# Test that the geometry aggregates survive invalid geometries instead of
# crashing. Boost.Geometry has no error handler to register and does not reject
# the bowties; it returns an empty result for them. The regression this guards
# is the crash, not the particular answer.

# ST_Union_Agg with self-intersecting (bowtie) polygons
query I
SELECT ST_AsText(ST_Union_Agg(geom)) FROM (VALUES
  ('POLYGON ((0 0, 10 10, 10 0, 0 10, 0 0))'::geometry),
  ('POLYGON ((20 20, 30 30, 30 20, 20 30, 20 20))'::geometry)
) AS t(geom);
----
MULTIPOLYGON EMPTY
