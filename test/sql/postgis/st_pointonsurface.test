# Example taken from the PostGIS manual @ http://postgis.net, licensed under the Creative Commons Attribution-Share Alike 3.0 License.

require spatial

query I
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('POINT(0 5)')));
----
POINT (0 5)

query I
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('LINESTRING(0 5, 0 10)')));
----
POINT (0 5)

query I
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText('POLYGON((0 0, 0 5, 5 5, 5 0, 0 0))')));
----
POINT (2.5 2.5)

query II
SELECT ST_AsText(ST_PointOnSurface(geom)) AS pt_on_surf,
       ST_AsText(ST_Centroid(geom)) AS centroid
FROM (SELECT ST_GeomFromText('POLYGON ((130 120, 120 190, 30 140, 50 20, 190 20, 170 100, 90 60, 90 130, 130 120))') AS geom);
----
POINT (62.5 110)	POINT (100.18264840182648 85.11415525114155)

query I
SELECT ST_AsText(ST_PointOnSurface(ST_GeomFromText(wkt))) FROM (VALUES
    (1, 'POLYGON((0 0,10 0,10 10,0 10,0 0),(2 2,8 2,8 8,2 8,2 2))'),
    (2, 'MULTIPOLYGON(((0 0,1 0,1 1,0 1,0 0)),((10 0,14 0,14 4,10 4,10 0)))'),
    (3, 'MULTIPOLYGON(((0 0,2 0,2 2,0 2,0 0)),((10 0,12 0,12 2,10 2,10 0)))'),
    (4, 'POLYGON((0 0,10 0,10 10,7 10,7 3,3 3,3 10,0 10,0 0))'),
    (5, 'POLYGON((0 0,4 0,2 3,0 0))'),
    (6, 'POLYGON((0 0,1 1,2 2,0 0))'),
    (7, 'POLYGON((0 0,3 0,3 1,1 1,1 2,3 2,3 3,0 3,0 0))'),
    (8, 'LINESTRING(0 0,1 1,2 0,3 1,4 0)'),
    (9, 'LINESTRING(1 1,2 0,0 0,1 1)'),
    (10, 'MULTILINESTRING((0 0,10 0),(0 5,10 5))'),
    (11, 'MULTILINESTRING((0 0,1 3,10 0),(0 5,4 4,10 5))'),
    (12, 'MULTIPOINT((0 0),(10 0),(4 1),(6 -1))'),
    (13, 'MULTIPOINT((0 0),(2 0))')
) t(id, wkt) ORDER BY id;
----
POINT (1 5)
POINT (12 2)
POINT (1 1)
POINT (1.5 6.5)
POINT (2 1.5)
POINT (0 0)
POINT (0.5 1.5)
POINT (2 0)
POINT (2 0)
POINT (0 0)
POINT (4 4)
POINT (4 1)
POINT (0 0)
