require spatial

# CRS is propagated through constructive functions
query I
SELECT st_crs(st_boundary(CAST('POINT(0 1)' AS "GEOMETRY"('OGC:CRS84'))))
----
OGC:CRS84

# CRS Is propagated through aggregate functions
query I
SELECT st_crs(st_union_agg(('POINT(0 1)'::GEOMETRY('OGC:CRS84'))));
----
OGC:CRS84

# CRS is propagated through lists
query I
SELECT st_crs(st_collect(main.list_value(CAST('POINT(0 1)' AS "GEOMETRY"('OGC:CRS84')))))
----
OGC:CRS84

# CRS is propagated through binary functions
query I
SELECT st_crs(st_intersection(CAST('POINT(0 1)' AS "GEOMETRY"('OGC:CRS84')), CAST('POINT(0 1)' AS "GEOMETRY"('OGC:CRS84'))))
----
OGC:CRS84

# But can't be mixed
statement error
SELECT st_crs(st_intersection('POINT(0 1)'::GEOMETRY('OGC:CRS84'), 'POINT(0 1)'::GEOMETRY('OGC:CRS83')));
----
Binder Error:
